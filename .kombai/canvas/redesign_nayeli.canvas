        "x": 0,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=Lexend:wght@300;400;500;600&display=swap');\n\n  :root {\n    --color-primary: #00383a;\n    --color-bg: #f2f4f8;\n    --font-heading: 'Bricolage Grotesque', sans-serif;\n    --font-body: 'Lexend', sans-serif;\n  }\n\n  body {\n    margin: 0;\n    font-family: var(--font-body);\n    background-color: var(--color-bg);\n    color: var(--color-primary);\n  }\n\n  .scroll-stack {\n    position: relative;\n    height: calc(var(--n) * 100vh);\n  }\n\n  .scroll-stack__viewport {\n    position: sticky;\n    top: 0;\n    height: 100vh;\n    overflow: hidden;\n  }\n\n  .scroll-stack__slide {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    will-change: transform, filter;\n    backface-visibility: hidden;\n    transform: translate3d(100%, 0, 0);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n  }\n\n  .scroll-stack__slide:first-child {\n    transform: none;\n  }\n\n  .scroll-stack__bg {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    z-index: 0;\n  }\n\n  .scroll-stack__overlay {\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(to bottom, rgba(0, 56, 58, 0.4), rgba(0, 56, 58, 0.1));\n    z-index: 1;\n  }\n\n  .scroll-stack__content {\n    position: relative;\n    z-index: 10;\n    max-width: 1100px;\n    width: 100%;\n    padding: 0 4rem;\n    text-align: left;\n  }\n\n  .heading-large {\n    font-family: var(--font-heading);\n    font-size: 7rem;\n    font-weight: 800;\n    line-height: 0.9;\n    letter-spacing: -0.04em;\n    margin: 0;\n    color: white;\n    text-transform: uppercase;\n  }\n\n  .subtitle-large {\n    font-family: var(--font-body);\n    font-size: 1.5rem;\n    font-weight: 400;\n    margin-top: 2rem;\n    color: rgba(255, 255, 255, 0.9);\n    max-width: 600px;\n    line-height: 1.4;\n  }\n\n  .nav-header {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    padding: 2rem 4rem;\n    z-index: 100;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    mix-blend-mode: difference;\n    color: white;\n  }\n\n  .nav-logo {\n    font-family: var(--font-heading);\n    font-size: 1.5rem;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n  }\n\n  .nav-links {\n    display: flex;\n    gap: 3rem;\n    font-size: 0.875rem;\n    font-weight: 500;\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n  }\n\n  .cta-button {\n    display: inline-block;\n    margin-top: 3rem;\n    padding: 1.25rem 2.5rem;\n    background-color: white;\n    color: var(--color-primary);\n    font-weight: 600;\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n    text-decoration: none;\n    border-radius: 0;\n    transition: all 0.3s ease;\n  }\n\n  .cta-button:hover {\n    background-color: var(--color-primary);\n    color: white;\n  }\n\n  .slide-number {\n    position: absolute;\n    bottom: 4rem;\n    left: 4rem;\n    font-family: var(--font-heading);\n    font-size: 1.25rem;\n    font-weight: 700;\n    color: white;\n    z-index: 10;\n  }\n\n  .metric-box {\n    margin-top: 3rem;\n    display: flex;\n    gap: 4rem;\n  }\n\n  .metric-item h4 {\n    font-family: var(--font-heading);\n    font-size: 3.5rem;\n    margin: 0;\n    color: white;\n  }\n\n  .metric-item p {\n    font-size: 0.875rem;\n    color: rgba(255, 255, 255, 0.7);\n    margin: 0.5rem 0 0;\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n  }\n</style>\n<nav class=\"nav-header\" data-kid=\"1\" data-name=\"navigation header\">\n<div class=\"nav-logo\" data-kid=\"1-1\" data-name=\"navigation logo\">Nayeli Aldana</div>\n<div class=\"nav-links\" data-kid=\"1-2\" data-name=\"navigation links container\">\n<span data-kid=\"1-2-1\" data-name=\"navigation link strategy\">Estrategia</span>\n<span data-kid=\"1-2-2\" data-name=\"navigation link operations\">Operaciones</span>\n<span data-kid=\"1-2-3\" data-name=\"navigation link projects\">Proyectos</span>\n<span data-kid=\"1-2-4\" data-name=\"navigation link contact\">Contacto</span>\n</div>\n</nav>\n<div class=\"scroll-stack\" data-kid=\"2\" data-name=\"scroll stack container\" style=\"--n: 5\">\n<div class=\"scroll-stack__viewport\" data-kid=\"2-1\" data-name=\"scroll stack viewport\">\n\n<div class=\"scroll-stack__slide\" data-dynamic=\"true\" data-kid=\"2-1-1\" data-name=\"hero slide\" data-reason=\"slide styles and transform recomputed on scroll\" style=\"z-index: 1\">\n<img alt=\"Nayeli Aldana Portrait\" class=\"scroll-stack__bg\" data-kid=\"2-1-1-1\" data-name=\"hero background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/17489840/pexels-photo-17489840.jpeg?auto=format&amp;w=1440&amp;q=80\">\n<div class=\"scroll-stack__overlay\" data-kid=\"2-1-1-2\" data-name=\"hero background overlay\" style=\"background: linear-gradient(to right, rgba(0, 56, 58, 0.7), transparent);\"></div>\n<div class=\"scroll-stack__content\" data-kid=\"2-1-1-3\" data-name=\"hero content wrapper\">\n<h1 class=\"heading-large\" data-kid=\"2-1-1-3-1\" data-name=\"hero headline text\">Nayeli<br data-kid=\"2-1-1-3-1-1\" data-name=\"line break\">Aldana</h1>\n<p class=\"subtitle-large\" data-kid=\"2-1-1-3-2\" data-name=\"hero subtitle text\">Masterclass en Logística y Gestión de Operaciones. Estrategias de alto impacto para cadenas de suministro resilientes.</p>\n<a class=\"cta-button\" data-kid=\"2-1-1-3-3\" data-name=\"explore projects call-to-action button\" href=\"#\">Explorar Trayectoria</a>\n</div>\n<div class=\"slide-number\" data-kid=\"2-1-1-4\" data-name=\"slide counter\">01 / 05</div>\n</div>\n\n<div class=\"scroll-stack__slide\" data-dynamic=\"true\" data-kid=\"2-1-2\" data-name=\"strategic vision slide\" data-reason=\"slide styles and transform recomputed on scroll\" style=\"z-index: 2\">\n<img alt=\"Logistics Control Room\" class=\"scroll-stack__bg\" data-kid=\"2-1-2-1\" data-name=\"strategic vision background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1639313521811-fdfb1c040ddb?auto=format&amp;w=1440&amp;q=80&amp;fit=crop\">\n<div class=\"scroll-stack__overlay\" data-kid=\"2-1-2-2\" data-name=\"strategic vision background overlay\"></div>\n<div class=\"scroll-stack__content\" data-kid=\"2-1-2-3\" data-name=\"strategic vision content wrapper\">\n<h1 class=\"heading-large\" data-kid=\"2-1-2-3-1\" data-name=\"strategic vision headline text\">Visión<br data-kid=\"2-1-2-3-1-1\" data-name=\"line break\">Estratégica</h1>\n<p class=\"subtitle-large\" data-kid=\"2-1-2-3-2\" data-name=\"strategic vision subtitle text\">Diseño y optimización de procesos operativos mediante el análisis de datos masivos y toma de decisiones en tiempo real.</p>\n<div class=\"metric-box\" data-kid=\"2-1-2-3-3\" data-name=\"metrics container\">\n<div class=\"metric-item\" data-kid=\"2-1-2-3-3-1\" data-name=\"obsolescence metric item\">\n<h4 data-kid=\"2-1-2-3-3-1-1\" data-name=\"obsolescence stat\">20%</h4>\n<p data-kid=\"2-1-2-3-3-1-2\" data-name=\"obsolescence description\">Reducción de Obsolescencia</p>\n</div>\n<div class=\"metric-item\" data-kid=\"2-1-2-3-3-2\" data-name=\"delivery metric item\">\n<h4 data-kid=\"2-1-2-3-3-2-1\" data-name=\"delivery stat\">15min</h4>\n<p data-kid=\"2-1-2-3-3-2-2\" data-name=\"delivery description\">Mejora en Tiempo de Entrega</p>\n</div>\n</div>\n</div>\n<div class=\"slide-number\" data-kid=\"2-1-2-4\" data-name=\"slide counter\">02 / 05</div>\n</div>\n\n<div class=\"scroll-stack__slide\" data-dynamic=\"true\" data-kid=\"2-1-3\" data-name=\"operational experience slide\" data-reason=\"slide styles and transform recomputed on scroll\" style=\"z-index: 3\">\n<img alt=\"Automated Warehouse\" class=\"scroll-stack__bg\" data-kid=\"2-1-3-1\" data-name=\"operational experience background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1672552226650-796f40198c47?auto=format&amp;w=1440&amp;q=80&amp;fit=crop\">\n<div class=\"scroll-stack__overlay\" data-kid=\"2-1-3-2\" data-name=\"operational experience background overlay\"></div>\n<div class=\"scroll-stack__content\" data-kid=\"2-1-3-3\" data-name=\"operational experience content wrapper\">\n<h1 class=\"heading-large\" data-kid=\"2-1-3-3-1\" data-name=\"operational experience headline text\">Experiencia<br data-kid=\"2-1-3-3-1-1\" data-name=\"line break\">Operativa</h1>\n<p class=\"subtitle-large\" data-kid=\"2-1-3-3-2\" data-name=\"operational experience subtitle text\">Más de 3 años liderando la transformación de centros de distribución y almacenes automatizados de gran escala.</p>\n<div class=\"metric-box\" data-kid=\"2-1-3-3-3\" data-name=\"metrics container\">\n<div class=\"metric-item\" data-kid=\"2-1-3-3-3-1\" data-name=\"experience years metric item\">\n<h4 data-kid=\"2-1-3-3-3-1-1\" data-name=\"experience years stat\">3+</h4>\n<p data-kid=\"2-1-3-3-3-1-2\" data-name=\"experience years description\">Años de Experiencia</p>\n</div>\n<div class=\"metric-item\" data-kid=\"2-1-3-3-3-2\" data-name=\"methodology metric item\">\n<h4 data-kid=\"2-1-3-3-3-2-1\" data-name=\"methodology stat\">5S</h4>\n<p data-kid=\"2-1-3-3-3-2-2\" data-name=\"methodology description\">Metodología Aplicada</p>\n</div>\n</div>\n</div>\n<div class=\"slide-number\" data-kid=\"2-1-3-4\" data-name=\"slide counter\">03 / 05</div>\n</div>\n\n<div class=\"scroll-stack__slide\" data-dynamic=\"true\" data-kid=\"2-1-4\" data-name=\"impact projects slide\" data-reason=\"slide styles and transform recomputed on scroll\" style=\"z-index: 4\">\n<img alt=\"Supply Chain Visualization\" class=\"scroll-stack__bg\" data-kid=\"2-1-4-1\" data-name=\"impact projects background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/17485706/pexels-photo-17485706.png?auto=format&amp;w=1440&amp;q=80\">\n<div class=\"scroll-stack__overlay\" data-kid=\"2-1-4-2\" data-name=\"impact projects background overlay\"></div>\n<div class=\"scroll-stack__content\" data-kid=\"2-1-4-3\" data-name=\"impact projects content wrapper\">\n<h1 class=\"heading-large\" data-kid=\"2-1-4-3-1\" data-name=\"impact projects headline text\">Proyectos de<br data-kid=\"2-1-4-3-1-1\" data-name=\"line break\">Impacto</h1>\n<p class=\"subtitle-large\" data-kid=\"2-1-4-3-2\" data-name=\"impact projects subtitle text\">De la digitalización de reportes manuales a tableros de control interactivos que impulsan la eficiencia global.</p>\n<a class=\"cta-button\" data-kid=\"2-1-4-3-3\" data-name=\"view projects call-to-action button\" href=\"#\">Ver Casos de Estudio</a>\n</div>\n<div class=\"slide-number\" data-kid=\"2-1-4-4\" data-name=\"slide counter\">04 / 05</div>\n</div>\n\n<div class=\"scroll-stack__slide\" data-dynamic=\"true\" data-kid=\"2-1-5\" data-name=\"connect slide\" data-reason=\"slide styles and transform recomputed on scroll\" style=\"z-index: 5\">\n<img alt=\"Office Desk Minimalist\" class=\"scroll-stack__bg\" data-kid=\"2-1-5-1\" data-name=\"connect background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/1007023/pexels-photo-1007023.jpeg?auto=format&amp;w=1440&amp;q=80\">\n<div class=\"scroll-stack__overlay\" data-kid=\"2-1-5-2\" data-name=\"connect background overlay\" style=\"background: rgba(0, 56, 58, 0.8);\"></div>\n<div class=\"scroll-stack__content\" data-kid=\"2-1-5-3\" data-name=\"connect content wrapper\" style=\"text-align: center; margin: 0 auto;\">\n<h1 class=\"heading-large\" data-kid=\"2-1-5-3-1\" data-name=\"connect headline text\">Optimicemos<br data-kid=\"2-1-5-3-1-1\" data-name=\"line break\">Juntos</h1>\n<p class=\"subtitle-large\" data-kid=\"2-1-5-3-2\" data-name=\"connect subtitle text\" style=\"margin: 2rem auto;\">Estoy disponible para consultorías estratégicas y colaboraciones en el sector logístico.</p>\n<a class=\"cta-button\" data-kid=\"2-1-5-3-3\" data-name=\"connect call-to-action button\" href=\"mailto:hola@nayelialdana.com\">Iniciar Conversación</a>\n</div>\n<div class=\"slide-number\" data-kid=\"2-1-5-4\" data-name=\"slide counter\">05 / 05</div>\n</div>\n</div>\n</div>\n<script data-kid=\"3\">\n(function () {\n  const container = document.querySelector('.scroll-stack');\n  const slides    = [...container.querySelectorAll('.scroll-stack__slide')];\n  const n         = slides.length;\n\n  const MAX_BLUR = 8, DIM = 0.4, SCALE = 0.05;\n  const DIRS = [{ x: 0, y: -1 }, { x: 0, y: 1 }, { x: -1, y: 0 }, { x: 1, y: 0 }];\n  \n  // Asignamos una dirección aleatoria pero fija a cada slide (excepto el primero)\n  const dirOf = slides.map((_, i) => i === 0 ? null : DIRS[Math.floor(Math.random() * DIRS.length)]);\n\n  function clamp(v, a, b) { return Math.min(b, Math.max(a, v)); }\n\n  let ticking = false;\n  function render() {\n    ticking = false;\n    const dist = container.offsetHeight - window.innerHeight;\n    const scrolled = -container.getBoundingClientRect().top;\n    const P = dist <= 0 ? 0 : clamp(scrolled / dist, 0, 1);\n    const segF = P * (n - 1);\n    const seg  = clamp(Math.floor(segF), 0, n - 2);\n    const sp   = clamp(segF - seg, 0, 1);\n\n    slides.forEach((slide, i) => {\n      if (i <= seg) {\n        if (i === seg) {\n          // El slide que está siendo cubierto retrocede\n          slide.style.transform = `translate3d(0,0,0) scale(${1 - SCALE * sp})`;\n          slide.style.filter    = `blur(${MAX_BLUR * sp}px) brightness(${1 - DIM * sp})`;\n          slide.style.opacity   = 1;\n        } else {\n          // Slides ya cubiertos\n          slide.style.transform = `translate3d(0,0,0) scale(${1 - SCALE})`;\n          slide.style.filter    = `blur(${MAX_BLUR}px) brightness(${1 - DIM})`;\n          slide.style.opacity   = 0; // Ocultamos para performance\n        }\n      } else if (i === seg + 1) {\n        // El slide que está entrando\n        const d = dirOf[i];\n        slide.style.transform = `translate3d(${d.x * (1 - sp) * 100}%, ${d.y * (1 - sp) * 100}%, 0)`;\n        slide.style.filter = 'none';\n        slide.style.opacity = 1;\n      } else {\n        // Slides que aún no entran\n        const d = dirOf[i];\n        slide.style.transform = `translate3d(${d.x * 100}%, ${d.y * 100}%, 0)`;\n        slide.style.filter = 'none';\n        slide.style.opacity = 0;\n      }\n    });\n  }\n\n  function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(render); } }\n  window.addEventListener('scroll', onScroll, { passive: true });\n  window.addEventListener('resize', onScroll);\n  render();\n}());\n</script>",
